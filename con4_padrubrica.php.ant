class rubrica {

     var $arq=null;

  function rubrica($header){
     umask(74);
     $this->arq = fopen("tmp/RUBRICA.TXT",'w+');
     fputs($this->arq,$header);
     fputs($this->arq,"\r\n");  

  }  

  function processa($instit=1,$data_ini="",$data_fim="") {
    global $nomeinst,$o58_anousu,$o56_elemento,$o56_descr,$nivel,$tipo,$elemento;
    global $contador;
    $contador=0;

    for($a=1999;$a < db_getsession("DB_anousu")+1 ;$a++){
          $ano = 2005;
          $ano = $a;
          $sql = "       
              select distinct on (elemento) elemento,
	             $ano as ano,
                     tipo,
                     o56_descr,
	             nivel
              from (
 		    select
		       case when $ano<=2004 then
                         ('000'|| substr(o56_elemento,2,6))||'000000'::varchar(15)
	               else
	                 ('00'|| substr(o56_elemento,2,7))||'0000000' ::varchar(15)
		       end as elemento,
		       case when o58_coddot is null then
		           'S' else 'A'
		       end as tipo,
		       o56_descr,
		       case when $ano = 2005 then
		          fc_nivel_plano2005(o56_elemento||'00')
		       else '8'
		          end as nivel
		       from orcelemento
	                   left outer join orcdotacao on o58_codele=o56_codele 
		       where o58_anousu = 2005
		       order by elemento
	        ) as x
           ";
//           echo $sql;exit;
         $result = pg_exec($sql);
         
	 for($i=0;$i<pg_numrows($result);$i++){
            db_fieldsmemory($result,$i);
            $contador ++;
            $line  = formatar($ano,4,'n');
            if ($line == 2005){
              $elemento = $elemento."0"; 
            }	 
            $line .= formatar($elemento,15,'c');
            $line .= formatar($o56_descr,110,'c');
            $line .= $tipo;
            $line .= formatar($nivel-1,2,'n');
  
            fputs($this->arq,$line);
            fputs($this->arq,"\r\n");
	 }   
    }
    
    //  trailer
    $contador = espaco(10-(strlen($contador)),'0').$contador;
    $line = "FINALIZADOR".$contador;
    fputs($this->arq,$line);
    fputs($this->arq,"\r\n");

    fclose($this->arq);

    pg_exec("commit");


    $teste = "true";
    return $teste ;

 }
}

?>