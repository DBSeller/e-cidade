include("dbforms/db_funcoes.php");
$clprotprocesso = new cl_protprocesso;
db_postmemory($HTTP_SERVER_VARS);
db_postmemory($HTTP_POST_VARS);
$clprotprocesso = new cl_protprocesso;
$clproctipovar = new cl_proctipovar;
$db_opcao = 1;
$data = getdate();
$db_botao = true;
if((isset($HTTP_POST_VARS["db_opcao"]) && $HTTP_POST_VARS["db_opcao"])=="Incluir"){
  db_inicio_transacao();
  $clprotprocesso->p58_id_usuario = db_getsession("DB_id_usuario");
  $clprotprocesso->p58_coddepto = db_getsession("DB_coddepto");
  $clprotprocesso->p58_codandam =  db_getsession("DB_id_usuario");
  $clprotprocesso->incluir($p58_codproc);
  $sql = "select p54_codigo, p54_codcam from procvar where p54_codigo = $p58_codigo;";
  $rs = pg_exec($sql);
  if (pg_num_rows($rs) > 0){ 
      while ($ln = pg_fetch_array($rs)){
           $sql2 = "select nomecam from db_syscampo where codcam = ".$ln["p54_codcam"];
           $rscam = pg_exec($sql2);
           $nomecam = trim(pg_result($rscam,0,"nomecam")); 
           $p55_codproc = $clprotprocesso->p58_codproc;
           $p55_codvar = $ln["p54_codigo"];
           $p55_codcam = $ln["p54_codcam"];
           $clproctipovar->p55_conteudo = $$nomecam;
           $clproctipovar->incluir($p55_codproc,$p55_codvar,$p55_codcam);  
          // $clproctipovar->erro(true,false);
	  // echo "<script>alert('Processo: ".$p55_codproc."\\n Variavel: ".$p55_codvar."\\n Campo: ".$p55_codcam."\\nCOnteudo: ".$$nomecam."')</script>";
  db_fim_transacao();
    } 
  }
}
