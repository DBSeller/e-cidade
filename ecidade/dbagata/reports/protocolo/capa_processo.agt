<?xml version="1.0"?>
<Report>
    <Version>7.4</Version>
    <Properties>
        <Title></Title>
        <Author></Author>
        <Date></Date>
    </Properties>
    <Parameters>
        <codigo_processo>
            <mask></mask>
            <value>16113</value>
            <label></label>
            <options></options>
        </codigo_processo>
        <codigo_processo_fim>
            <mask></mask>
            <value>16113</value>
            <label></label>
            <options></options>
        </codigo_processo_fim>
        <codigo_instituicao>
            <mask></mask>
            <value>1</value>
            <label></label>
            <options></options>
        </codigo_instituicao>
        <codigo_departamento>
            <mask></mask>
            <value>1</value>
            <label></label>
            <options></options>
        </codigo_departamento>
    </Parameters>
    <Header>
        <Body></Body>
    </Header>
    <Footer>
        <Body></Body>
    </Footer>
    <DataSet>
        <DataSource>
            <Name>bage</Name>
        </DataSource>
        <Query>
            <Select>protprocesso.p58_numero                                                    as numero_processo,
                    protprocesso.p58_codproc                                                   as numero_controle,
                    protprocesso.p58_dtproc                                                    as data_processo,
                    protprocesso.p58_hora                                                      as hora_processo,
                    protprocesso.p58_ano                                                       as ano_processo,
                    cgmprocesso.z01_numcgm                                                     as numero_cgm,
                    cgmprocesso.z01_nome                                                       as nome,
                    cgmprocesso.z01_ender                                                      as endereco,
                    cgmprocesso.z01_compl                                                      as endereco_complemento, 
                    cgmprocesso.z01_numero                                                     as numero,
                    cgmprocesso.z01_munic                                                      as municipio_cgm,
                    tipoproc.p51_codigo                                                        as codigo_tipo_processo,
                    tipoproc.p51_descr                                                         as descricao_processo,
                    (select coddepto     from db_depart where coddepto = $codigo_departamento) as numero_departamento,
                    (select descrdepto   from db_depart where coddepto = $codigo_departamento) as descricao_departamento,
                    (select emaildepto   from db_depart where coddepto = $codigo_departamento) as email_departamento,
                    (select fonedepto    from db_depart where coddepto = $codigo_departamento) as telefone_departamento,
                    (select ramaldepto   from db_depart where coddepto = $codigo_departamento) as ramal_departamento,
                    (select faxdepto     from db_depart where coddepto = $codigo_departamento) as fax_departamento,
                    (select munic        from db_config where codigo   = $codigo_instituicao)  as municipio_instituicao,
                    (select telef        from db_config where codigo   = $codigo_instituicao)  as telefone_instituicao,
                    (select fax          from db_config where codigo   = $codigo_instituicao)  as fax_instituicao,
                    (select db12_extenso from db_config 
                      inner join db_uf on db_uf.db12_uf = db_config.uf 
                      where codigo   = $codigo_instituicao)                                    as estado_instituicao,
                    protprocesso.p58_requer                                                    as requerente,
                    p58_obs                                                                    as observacoes_processo,
                    cgmprocesso.z01_cgccpf                                                     as cpf_cnpj_cgm,
                    cgmprocesso.z01_telef                                                      as telefone_cgm,
                    cgmprocesso.z01_bairro                                                     as bairro_cgm,
                    cgmusuario.z01_nome                                                        as nome_emissor,
                    current_date                                                               as data_emissao</Select>
            <From>protprocesso 
                  inner join cgm cgmprocesso       on cgmprocesso.z01_numcgm      = protprocesso.p58_numcgm
                  inner join tipoproc   on tipoproc.p51_codigo = protprocesso.p58_codigo
                  inner join db_usuacgm on protprocesso.p58_id_usuario = db_usuacgm.id_usuario
                  inner join cgm cgmusuario  on db_usuacgm.cgmlogin = cgmusuario.z01_numcgm </From>
            <Where>protprocesso.p58_codproc BETWEEN $codigo_processo AND $codigo_processo_fim</Where>
            <GroupBy></GroupBy>
            <OrderBy></OrderBy>
        </Query>
        <Groups>
            <Config>
                <ShowGroup>0</ShowGroup>
                <ShowDetail>1</ShowDetail>
                <ShowLabel>0</ShowLabel>
                <ShowNumber>1</ShowNumber>
                <ShowIndent>1</ShowIndent>
                <ShowHeader>0</ShowHeader>
            </Config>
        </Groups>
