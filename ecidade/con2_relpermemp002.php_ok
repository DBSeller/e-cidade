$pdf->Cell(25,$largura,$RLdb20_projativ,1,0,"C",0);
$pdf->Cell(25,$largura,$RLdb20_codele,1,0,"C",0);
$pdf->Cell(25,$largura,$RLdb20_codigo,1,0,"C",0);
$pdf->Ln();
$novo=true;
$tot=0;
for($i=0;$i<$numrows;$i++){
  db_fieldsmemory($result,$i);
    if ($pdf->gety() > ($pdf->h-40)) {
	$pdf->AddPage("P");
	$pdf->SetFont('Arial','B',8);
	if(isset($id_usuario) && $id_usuario!='') {
	  $pdf->Cell(185,$largura,"$RLnome:$nome",1,0,"L",0);
	}else{
	  $pdf->Cell(185,$largura,"$RLdescrdepto:$descrdepto",1,0,"L",0);
	}  
        $pdf->Ln();
	$pdf->Cell(15,$largura,$RLdb20_codperm,1,0,"C",0);
	$pdf->Cell(15,$largura,$RLdb20_orgao,1,0,"C",0);
	$pdf->Cell(15,$largura,$RLdb20_unidade,1,0,"C",0);
	$pdf->Cell(15,$largura,$RLdb20_funcao,1,0,"C",0);
	$pdf->Cell(25,$largura,$RLdb20_subfuncao,1,0,"C",0);
	$pdf->Cell(25,$largura,$RLdb20_programa,1,0,"C",0);
	$pdf->Cell(25,$largura,$RLdb20_projativ,1,0,"C",0);
	$pdf->Cell(25,$largura,$RLdb20_codele,1,0,"C",0);
	$pdf->Cell(25,$largura,$RLdb20_codigo,1,0,"C",0);
	$pdf->Ln();
    }
    $pdf->SetFont('Arial','',8);
    $pdf->Cell(15,$largura,$db20_codperm,1,0,"C",0);
    $pdf->Cell(15,$largura,$db20_orgao,1,0,"C",0);
    $pdf->Cell(15,$largura,$db20_unidade,1,0,"C",0);
    $pdf->Cell(15,$largura,$db20_funcao,1,0,"C",0);
    $pdf->Cell(25,$largura,$db20_subfuncao,1,0,"C",0);
    $pdf->Cell(25,$largura,$db20_programa,1,0,"C",0);
    $pdf->Cell(25,$largura,$db20_projativ,1,0,"C",0);
    $pdf->Cell(25,$largura,$db20_codele,1,0,"C",0);
    $pdf->Cell(25,$largura,$db20_codigo,1,0,"C",0);
    $pdf->Ln();
}
$pdf->Output();
