parse_str($HTTP_SERVER_VARS["QUERY_STRING"]);

$cldb_permemp->rotulo->label();
$clrotulo = new rotulocampo;
$clrotulo->label("id_usuario");
$clrotulo->label("nome");
$clrotulo->label("coddepto");
$clrotulo->label("descrdepto");

if(isset($id_usuario) && $id_usuario!='') {
  $result= $cldb_usuarios->sql_record($cldb_usuarios->sql_query_file($id_usuario,"nome"));
  if($cldb_usuarios->numrows>0){
     db_fieldsmemory($result,0); 
     $dbwhere="  db21_id_usuario = $id_usuario ";  
  }else{
     db_redireciona('db_erros.php?fechar=true&db_erro=Código de usuário inválido!');
  }   
}else if(isset($coddepto) && $coddepto!=''){
  $result= $cldb_depart->sql_record($cldb_depart->sql_query_file($coddepto,"descrdepto"));
  if($cldb_depart->numrows>0){
     db_fieldsmemory($result,0); 
     $dbwhere="  db22_coddepto = $coddepto ";  
  }else{
     db_redireciona('db_erros.php?fechar=true&db_erro=Código de departamento inválido!');
  }   
}

$sql = $cldb_permemp->sql_query_origem(null,"db20_codperm,db20_anousu,db20_orgao,db20_unidade,db20_funcao,db20_subfuncao,db20_programa,db20_projativ,db20_codele,db20_codigo",'db20_orgao',"$dbwhere");
$result  = $cldb_permemp->sql_record($sql);     
$numrows = $cldb_permemp->numrows; 
if($numrows==0){
     db_redireciona('db_erros.php?fechar=true&db_erro=Não foi encontrado nenhuma permissão!');
}


$pdf = new pdf("L");
$largura = 6;
$pdf->Open();
//$head1 = "$RLo60_anousu:$anousu";
$pdf->AliasNbPages();
$pdf->AddPage("P");
$pdf->SetFillColor(220);

$pdf->SetFont('Arial','B',8);
if(isset($id_usuario) && $id_usuario!='') {
  $pdf->Cell(185,$largura,"$RLnome:$nome",1,0,"L",0);
}else{
  $pdf->Cell(185,$largura,"$RLdescrdepto:$descrdepto",1,0,"L",0);
}  
$pdf->Ln();
$pdf->Cell(15,$largura,$RLdb20_codperm,1,0,"C",0);
$pdf->Cell(15,$largura,$RLdb20_orgao,1,0,"C",0);
$pdf->Cell(15,$largura,$RLdb20_unidade,1,0,"C",0);
$pdf->Cell(15,$largura,$RLdb20_funcao,1,0,"C",0);
