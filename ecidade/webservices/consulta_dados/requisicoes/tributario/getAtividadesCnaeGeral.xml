<?xml version='1.0' ?>
<consulta distinct="true">
    <campos>
        <campo campo="q03_ativ"       label="codigo"    />
        <campo campo="q71_estrutural||'-'||q03_ativ||'-'||q03_descr"      label="descricao"        />
        <campo campo="q71_estrutural" label="estrutural_cnae"      />
        <campo campo="q71_descr"      label="descricao_cnae"        />
    </campos>
    <from tabela="ativid"/>
    <juncoes>
        <join tipo="inner"  tabela="atividcnae"    condicao="q03_ativ       = q74_ativid"          />
        <join tipo="inner"  tabela="cnaeanalitica" condicao="q72_sequencial = q74_cnaeanalitica"   />
        <join tipo="inner"  tabela="cnae"          condicao="q71_sequencial = q72_cnae"            />
    </juncoes>
    <filtros>
        <filtro label="estrutural_cnae" condicao="q71_estrutural ilike '%$estrutural_cnae%'" obrigatorio="false"/>
        <filtro label="permite_mei"     condicao="q71_permitemei is $permite_mei" obrigatorio="false"/>
        <filtro label="limite"          condicao="(q03_limite is null or q03_limite &gt;= to_char(now(), 'YYYY-MM-DD')::date)" autoexecuta="true"/>
    </filtros>
    <agrupamento campos="" />
    <ordenacao   campos="q03_ativ"/>
</consulta>
