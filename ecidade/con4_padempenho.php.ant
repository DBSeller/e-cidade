class empenho {
     var $arq=null;

  function empenho($header){
     umask(74);
     $this->arq = fopen("tmp/EMPENHO.TXT",'w+');
     fputs($this->arq,$header);
     fputs($this->arq,"\r\n");  
  }  

  function processa($instit=1,$data_ini="",$data_fim="") {
      global $contador,$nomeinst;
      global $o58_unidade,$o58_funcao,$o58_subfuncao,$o58_programa,$o58_subprograma,$o58_coddot;
    
      $contador=0;

      $sele = " (1,2) ";
      if(db_getsession("DB_instit")==3)
	$sele = " (3) ";


      $sql="select
                   distinct (e60_numemp),
	           e60_anousu,
		   trim(e60_codemp)::integer as e60_codemp,
		   o58_coddot,
                   o58_orgao,
                   o58_unidade,
    	           o58_funcao,
 	           o58_subfuncao,
                   o58_programa,
 	           o58_projativ, 
		   '00'||substr(o56_elemento,2,13)::varchar(15) as rubrica,
	           o58_codigo as recurso,
	           e60_emiss,
	           c70_valor as valor_empenho,
	           (case when c71_coddoc = 1 then '+' else '-' end)::char(1) as sinal,  
	           e60_numcgm,
	           e60_resumo
            from empempenho 
	        inner join conlancamemp on c75_numemp = e60_numemp
	        inner join conlancamdoc on c71_codlan = c75_codlan
	        inner join conlancam on c70_codlan = c75_codlan
                inner join orcdotacao on o58_coddot=e60_coddot
		                     and o58_anousu=e60_anousu
		inner join orcelemento on o56_codele = o58_codele
            where c75_data <=  '$data_fim'  
	        and e60_emiss <='$data_fim' 
		and e60_anousu = ".db_getsession("DB_anousu")."
		and c71_coddoc in (1,2)
		and e60_instit in $sele
            union 
	    select 
	           distinct (e91_numemp),
		   e60_anousu,
		   trim(e60_codemp)::integer as e60_codemp,
		   o58_coddot,
                   o58_orgao,
                   o58_unidade,
    	           o58_funcao,
 	           o58_subfuncao,
                   o58_programa,
 	           o58_projativ,
		   case when e60_anousu = 2005 then
                       '00'||substr(o56_elemento,2,12)::varchar(15)
		     else 
  		       '000'||substr(o56_elemento,2,13)::varchar(15)
		   end as rubrica,
	           o58_codigo as recurso,
	           e60_emiss,
	           round((e91_vlremp - e91_vlranu -e91_vlrpag),2)::float8 as valor_empenho,
	           '+'::char(1) as sinal,  
	           e60_numcgm,
	           e60_resumo
            from empresto
               inner join empempenho on e60_numemp = e91_numemp        
	       inner join orcdotacao on o58_coddot=e60_coddot and
	                                o58_anousu=e60_anousu
	       inner join orcelemento on o56_codele = o58_codele
	       
	    where e91_anousu = ".db_getsession("DB_anousu")."
                 and e60_instit in $sele
	    order by  e60_emiss, e60_codemp
            ";
      $res=pg_exec($sql);
      $rows = pg_numrows($res);
      for ($x=0;$x < $rows;$x++){
	  db_fieldsmemory($res,$x);
	  
          $ano               = pg_result($res,$x,"e60_anousu");
          $orgao        = formatar(pg_result($res,$x,"o58_orgao"),2,'n');
          // se ano menor que 2005, pega funcao, subfuncao e subprograma da tabel orcdotacaorp
	  if ($ano < 2005){
             $sql = "select o73_funcao      as o58_funcao,         
	                    o73_subfuncao   as o58_subfuncao,
	   	    	    o73_subprograma as o58_subprograma
                     from orcdotacaorp 
		     where o73_anousu=$ano
		        and o73_coddot=$o58_coddot
                 ";
             $rr = pg_exec($sql);		 
	     if (pg_numrows($rr)>0)
	       db_fieldsmemory($rr,0); 
	     else 
	       echo "<br> ano $ano $o58_coddot ";
          
	  }	  
          $unidade      = formatar($o58_unidade,2,'n');
          $funcao       = formatar($o58_funcao,2,'n');
          $subfuncao    = formatar($o58_subfuncao,3,'n');
          $programa     = formatar($o58_programa,4,'n');
          $subprograma  = formatar($o58_subprograma,3,'n');
          $proj_ativ       = formatar(pg_result($res,$x,"o58_projativ"),5,'n');
          
	  $rubrica = pg_result($res,$x,"rubrica");
	 // if ($ano <= 2004)
	 //    $rubrica = "0".$rubrica;

	  $rubrica = substr($rubrica,0,9)."00000000000000";
	  
          $rubrica_despesa   = formatar($rubrica,15,'c'); // pendente
	  
          $recurso           = formatar(pg_result($res,$x,"recurso"),4,'n');
          $contrapartida_recurso =  espaco(4,'0'); // pendente
	  
	  $numero_empenho    = "000".$ano.formatar(pg_result($res,$x,"e60_codemp"),6,'n');        
	  
          $data_empenho      = formatar(pg_result($res,$x,"e60_emiss"),8,'d');   
          $valor_empenho     = formatar(pg_result($res,$x,"valor_empenho")  ,13,'v');
          $sinal_valor       = pg_result($res,$x,"sinal");     
          $codigo_credor     = formatar(pg_result($res,$x,"e60_numcgm"),10,'n');
	  $hist       = pg_result($res,$x,"e60_resumo");
	  if ($hist =="")
	      $hist = "sem resumo";
	  $hist       = addcslashes($hist,"\r\n");
          $historico_empenho = formatar($hist,165,'c');

          //-- 
          $line = $orgao.$unidade.$funcao.$subfuncao.$programa.$subprograma.$proj_ativ.$rubrica_despesa.$recurso.$contrapartida_recurso.$numero_empenho.$data_empenho.$valor_empenho.$sinal_valor.$codigo_credor.$historico_empenho; 
          fputs($this->arq,$line);
          fputs($this->arq,"\r\n");

          $contador = $contador+1; // incrementa contador global
      }

      //  trailer
      $contador = espaco(10-(strlen($contador)),'0').$contador;
      $line = "FINALIZADOR".$contador;
      fputs($this->arq,$line);
      fputs($this->arq,"\r\n");



      fclose($this->arq);


      $teste = "true";
      return $teste;

  }

}

?>