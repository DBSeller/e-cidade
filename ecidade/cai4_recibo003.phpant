 $sql = "select r.k00_numcgm,r.k00_receit,upper(t.k02_descr) as k02_descr,upper(t.k02_drecei) as k02_drecei,r.k00_dtoper as k00_dtoper,k00_codsubrec,coalesce(upper(k07_descr),' ') as k07_descr ,sum(r.k00_valor) as valor,
            case when taborc.k02_codigo is null then tabplan.k02_reduz else
 taborc.k02_codrec end as codreduz
              from recibo r
                   
                   inner join tabrec t 		on t.k02_codigo = r.k00_receit 
                   inner join tabrecjm 		on tabrecjm.k02_codjm = t.k02_codjm
		   left outer join tabdesc 	on codsubrec = k00_codsubrec

                   left outer join taborc  on t.k02_codigo = taborc.k02_codigo 
and taborc.k02_anousu = ".db_getsession("DB_anousu")."
                   left outer join tabplan  on t.k02_codigo = tabplan.k02_codigo
 and tabplan.k02_anousu = ".db_getsession("DB_anousu")."

		      where r.k00_numpre = ".$k03_numpre."
              group by r.k00_dtoper,r.k00_receit,t.k02_descr,t.k02_drecei,r.k00_numcgm,k00_codsubrec,k07_descr,codreduz";



