include("fpdf151/pdf.php");
include("classes/db_diversos_classe.php");
include("libs/db_sql.php");
db_postmemory($HTTP_SERVER_VARS);

$clrotulo = new rotulocampo;
$cldiversos = new cl_diversos;
$clrotulo->label("dv09_descr");
$clrotulo->label("z01_nome");
$clrotulo->label("k00_matric");
$clrotulo->label("k00_inscr");
$cldiversos->rotulo->label();
$dbwhere="";
$dati="";
$er="(<strong>)|(</strong>)|(:)";
if($tipo=="tudo"){
 $dbwhere=""; 
}elseif($tipo=="datas"){
  $matriz= split("XX",$valor);
  $ini=split("X",$matriz[0]);  
  $fim=split("X",$matriz[1]);  
  $dbwhere= " dv05_dtinsc >= '".$ini[2]."-".$ini[1]."-".$ini[0]."' and dv05_dtinsc <= '".$fim[2]."-".$fim[1]."-".$fim[0]."'";
}elseif($dat!="nops"){
  $dbwhere= " $tipo = $valor ";
  $matriz= split("XX",$dat);
  $ini=split("X",$matriz[0]);  
  $fim=split("X",$matriz[1]);  
  $dbwhere .= " and  dv05_dtinsc >= '".$ini[2]."-".$ini[1]."-".$ini[0]."' and dv05_dtinsc <= '".$fim[2]."-".$fim[1]."-".$fim[0]."'";
}else{
  $dbwhere= " $tipo = $valor ";
}  
$result01=$cldiversos->sql_record($cldiversos->sql_pesquisa("","dv05_coddiver","$dbwhere"));
$numrows01=$cldiversos->numrows;
db_fieldsmemory($result01,0);
if($tipo=="dv05_procdiver"){
   $dati=strtoupper(ereg_replace($er,"",$Ldv05_procdiver).": ".$dv09_descr);
}else{
   $dati=strtoupper(ereg_replace($er,"",$Ldv05_procdiver).": TODAS");
}
if($tipo=="datas" || $dat!="nops"){
  $peri="PERÍODO: ".$ini[0]."/".$ini[1]."/".$ini[2]." até ".$fim[0]."/".$fim[1]."/".$fim[2];
}else{  
  $peri="PERÍODO: GERAL";
}  
if(!$numrows01>0){
  echo"
    <script>
      window.opener.js_erro('$tipo','$valor');
    </script>
  ";
}

$pdf = new PDF(); 
$pdf->Open(); 
$pdf->AliasNbPages(); 
$pdf->SetFont('Arial','',11);
$pdf->SetFillColor(250);
$head1 = "DIVERSOS";
$head3 = $peri;
$head5 = $dati;
if($situ=="p"){
$head7 = "SOMENTE OS PAGOS";
}elseif($situ=="np"){
  $head7 = "SOMENTE OS NÃO PAGOS";
}
$pripag="true";
$pago="";
$devido="";
$sd="0"; 
for($i=0;$i<$numrows01;$i++) {
   db_fieldsmemory($result01,$i);
   $result02=debitos_numpre($dv05_numpre,0,0,db_getsession("DB_datausu"),db_getsession("DB_anousu"),0,"1");
   if($result02!=false && pg_numrows($result02)>0){
     db_fieldsmemory($result02,0);
   }else{
     $total="0";
   }
   $result03= pg_query("select count(k00_valor) as parcelaspagas, sum(k00_valor) from arrepaga where k00_numpre = $dv05_numpre");
   if(pg_numrows($result03)>0){
     db_fieldsmemory($result03,0);
   }else{
     $sum="0"; 	
   }
   $total=$total-$sum;
   $pods="si";
   if($situ=="np"){
     if($total=="0"){
       $pods="nops";
     }
   }elseif($situ=="p"){
     if($total!="0"){
       $pods="nops";
     }
   }
  if($pods=="si"){
     if($k00_tipo=="CGM"){
       $val=$dv05_numcgm;
     }elseif($k00_tipo=="INSCRICAO"){
       $val=$k00_inscr;
     }elseif($k00_tipo=="MATRICULA"){
       $val=$k00_matric;
     }
     $y=$pdf->GetY();
     if($y>170 || $pripag=="true"){
       $pripag="false";
       $pdf->AddPage("L");
       $propag="false";
       $pdf->SetFont('Times','B',8);
       $pdf->SetFillColor(250);
       $pdf->SetLineWidth(0.4);
       $pdf->Cell("32",5,ereg_replace($er,"",$Ldv05_coddiver) ,1,0,"C",1); // 1
       $pdf->Cell("82",5,ereg_replace($er,"",$Lz01_nome)      ,1,0,"C",1); // 2
       $pdf->Cell("28",5,ereg_replace($er,"",$Ldv05_dtinsc)   ,1,0,"C",1); // 3
       $pdf->Cell("26",5,ereg_replace($er,"",$Ldv05_exerc)    ,1,0,"C",1); // 4
       $pdf->Cell("32",5,ereg_replace($er,"",$Ldv05_valor)    ,1,0,"C",1); // 5
       $pdf->Cell("26",5,ereg_replace($er,"",$RLdv05_diaprox) ,1,1,"C",1); // 6
      
      $pdf->Cell("32",5,"Origem"                             ,1,0,"C",1); // 1
       $pdf->Cell("82",5,ereg_replace($er,"",$Ldv05_procdiver),1,0,"C",1); // 2
       $pdf->Cell("28",5,ereg_replace($er,"",$Ldv05_oper)     ,1,0,"C",1); // 3
       $pdf->Cell("26",5,ereg_replace($er,"",$Ldv05_numtot)   ,1,0,"C",1); // 4
       $pdf->Cell("32",5,"Valor devido"                       ,1,0,"C",1); // 5
       $pdf->Cell("26",5,ereg_replace($er,"",$Ldv05_provenc)  ,1,1,"C",1); // 6
      
       $pdf->Cell("32",5,ereg_replace($er,"",$Ldv05_numpre)   ,1,0,"C",1); // 1
       $pdf->Cell("82",5,ereg_replace($er,"",$Ldv05_obs)      ,1,0,"C",1); // 2
       $pdf->Cell("28",5,ereg_replace($er,"",$Ldv05_privenc)  ,1,0,"C",1); // 3
       $pdf->Cell("26",5,ereg_replace($er,"",$Ldv05_vlrhis)   ,1,0,"C",1); // 4
       $pdf->Cell("32",5,"Valor pago"                         ,1,0,"C",1); // 5
       $pdf->Cell("26",5,"Parcelas pagas"                     ,1,1,"C",1); // 6
  
       $pdf->SetFont('Arial','',7);
       $pdf->SetLineWidth(0.2);
       $pdf->ln(1);
     }
     if($sd=="0"){
       $pdf->SetFillColor(210);
       $sd="1";
     }else{
       $sd="0";
       $pdf->SetFillColor(255);
     }  
     $pdf->Cell("32",5,"$dv05_coddiver",1,0,"R",1);
     $pdf->Cell("82",5,substr($z01_nome,0,55),1,0,"L",1);
     $pdf->Cell("28",5,db_formatar($dv05_dtinsc,'d'),1,0,"L",1);
     $pdf->Cell("26",5,"$dv05_exerc",1,0,"R",1);
     $pdf->Cell("32",5,db_formatar($dv05_valor,'f'," ",10),1,0,"R",1);
     $pdf->Cell("26",5,"$dv05_diaprox",1,1,"R",1);
     
     $pdf->Cell("32",5,"$k00_tipo $val",1,0,"L",1);
     $pdf->Cell("82",5,"$dv09_descr",1,0,"L",1);
     $pdf->Cell("28",5,"$dv05_oper",1,0,"L",1);
     $pdf->Cell("26",5,"$dv05_numtot",1,0,"R",1);
     $pdf->Cell("32",5,db_formatar($total,'f'," ",10),1,0,"R",1);
     $pdf->Cell("26",5,db_formatar($dv05_provenc,'d'),1,1,"L",1);
     
     $pdf->Cell("32",5,"$dv05_numpre",1,0,"R",1);
     $pdf->Cell("82",5,substr($dv05_obs,0,40),1,0,"L",1);
     $pdf->Cell("28",5,db_formatar($dv05_privenc,'d'),1,0,"L",1);
     $pdf->Cell("26",5,db_formatar($dv05_vlrhis,'f',' ',10),1,0,"R",1);
     $pdf->Cell("32",5,db_formatar($sum,'f'," ",10),1,0,"R",1);
     $pdf->Cell("26",5,$parcelaspagas,1,1,"R",1); 
     $pdf->ln(1);
     $pago+=$sum;
     $devido+=$total;
     if($numrows01==($i+1)){
       $pdf->SetFont('Times','B',6);
       $pdf->ln(1);
       $pdf->SetX(124);
       $pdf->Cell("36",4,"TOTAL DE REGISTROS: $numrows01",1,0,"L",0);
       $pdf->Cell("37",4,"TOTAL PAGO:".db_formatar($pago,'f'," ",10),1,0,"L",0);
       $pdf->Cell("39",4,"TOTAL DEVIDO:".db_formatar($devido,'f'," ",10),1,0,"L",0);
    }  
    $pdf->ln(0);
  } 
}
$pdf->Ln(5);
$pdf->Output();

?>